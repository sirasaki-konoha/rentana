{
  "name": "rentana",
  "version": "1.0.0",
  "description": "Blender風 3Dエディタ (Electron版)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n VITE,ELEC \"vite\" \"sleep 2 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder",
    "start": "electron ."
  },
  "keywords": [
    "3d",
    "editor",
    "electron",
    "three.js"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "ai.opencode.rentana",
    "productName": "Rentana",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
